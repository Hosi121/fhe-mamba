{
  "schema_version": 1,
  "metric": "eval_seconds",
  "equal": [
    "security_audit", "slots", "payload_slots", "ring_dimension",
    "refresh_ring_dimension", "depth", "scale_bits", "nodes", "evaluated_nodes",
    "generated_token_ids", "client_output_decrypt_count", "bootstrap_passes",
    "bootstraps", "logical_refreshes", "planned_logical_refreshes",
    "refresh_batches", "refresh_ceiling", "refreshed_level", "ct_ct_mul",
    "plaintext_cache_capacity", "prefetch_workers", "exact_tolerance",
    "polynomial_tolerance"
  ],
  "require": {
    "passed": true,
    "encrypted": true,
    "security": "128-classic",
    "security_audit.passed": true,
    "security_audit.library_classical128": true,
    "security_audit.uniform_ternary": true,
    "security_audit.hybrid": true,
    "gpu_dual_ring": false,
    "ring_switch_up_calls": 0,
    "ring_switch_down_calls": 0,
    "evaluation_decryptions": 0,
    "non_finite": 0,
    "bootstrap_passes": 2,
    "s2c_first": true,
    "frontier_refresh": true,
    "batch_refresh": true,
    "refresh_policy": "planned",
    "merge_refresh_fallbacks": 0,
    "exact_tolerance": 0.001,
    "polynomial_tolerance": 0.001
  },
  "maximum": {
    "max_abs_error_vs_exact": 0.001,
    "max_abs_error_vs_polynomial": 0.001
  },
  "minimum_reduction": 0.03
}
