{
  "schema_version": 1,
  "command": [
    "docker",
    "run",
    "--rm",
    "--name",
    "cipher-long-accuracy-diagnostic-fine-r3",
    "--user",
    "${UID}:${GID}",
    "--cpuset-cpus",
    "96-100",
    "--cpuset-mems",
    "3",
    "--shm-size",
    "1g",
    "--volume",
    "${root}:/workspace:ro",
    "--volume",
    "${root}/b300-mamba3-20260926:/work:ro",
    "--volume",
    "${study}:/study",
    "--volume",
    "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a:/workspace/install/openfhe-fides/lib/libOPENFHEcore_static.a:ro",
    "--volume",
    "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a:/work/install/fideslib/lib/fideslib.a:ro",
    "--volume",
    "${baseline}:/baseline:ro",
    "--workdir",
    "/study",
    "--env",
    "OMP_NUM_THREADS=4",
    "--env",
    "OMP_PROC_BIND=true",
    "--env",
    "OMP_PLACES={96},{98},{99},{100}",
    "--env",
    "LD_LIBRARY_PATH=/workspace/install/openfhe-fides/lib:/usr/local/cuda/lib64",
    "--gpus",
    "device=6",
    "--volume",
    "${payload_study}:/payloads:ro",
    "${image}",
    "/study/build/diagnostic/packed_fideslib",
    "/payloads/payload/tiled64/program.txt",
    "/study/diagnostic-fine-r3/native.json",
    ".001",
    ".001",
    "--planned-refresh",
    "--batch-refresh",
    "--inplace-ops",
    "--gpu-plaintext-ntt",
    "--profile-evaluation",
    "--naf-rotations",
    "--reuse-dead-inputs",
    "--direct-plaintext-upload",
    "--compact-weights",
    "--move-plaintext-coefficients",
    "--borrow-plaintext-upload",
    "--bsgs-routing-stages",
    "--cache-plaintexts",
    "--frontier-refresh",
    "--s2c-first",
    "--gpu-plaintext-rns",
    "--hoist-rotations",
    "--share-chebyshev",
    "--prefetch-plaintexts",
    "--prefetch-workers",
    "2",
    "--security",
    "128-classic",
    "--security-digits",
    "4",
    "--gpu-addend-rns",
    "--plaintext-cache-capacity",
    "2048",
    "--merge-refresh-correction",
    "--gpu-plaintext-fft",
    "--frontier-live-limit",
    "256",
    "--client-head",
    "/payloads/payload/tiled64/client_head.f32",
    "--diagnostic-reference",
    "/study/references-fine-r3/references.bin",
    "--diagnostic-output",
    "/study/diagnostic-fine-r3/observations.jsonl"
  ],
  "cwd": "${study}",
  "inputs": {
    "source": "${study}/diagnostic-source.tar.gz",
    "native_source": "${study}/diagnostic-source.tar.gz",
    "binary": "${study}/build/diagnostic/packed_fideslib",
    "openfhe_core": "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a",
    "fideslib": "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a",
    "program": "${payload_study}/payload/tiled64/program.txt",
    "manifest": "${payload_study}/payload/tiled64/manifest.json",
    "fixture": "${payload_study}/payload/tiled64/fixture.npz",
    "client_head": "${payload_study}/payload/tiled64/client_head.f32",
    "diagnostic_references": "${study}/references-fine-r3/references.bin",
    "diagnostic_metadata": "${study}/references-fine-r3/references.json",
    "reference_exporter": "${study}/export-references-fine-r3.py"
  },
  "timeout_seconds": 7200
}
