{
  "schema_version": 1,
  "command": [
    "docker",
    "run",
    "--rm",
    "--name",
    "cipher-long-accuracy-replay-refresh",
    "--user",
    "${UID}:${GID}",
    "--cpuset-cpus",
    "80-84",
    "--cpuset-mems",
    "2",
    "--shm-size",
    "1g",
    "--volume",
    "${root}:/workspace:ro",
    "--volume",
    "${root}/b300-mamba3-20260926:/work:ro",
    "--volume",
    "${study}:/study",
    "--volume",
    "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a:/workspace/install/openfhe-fides/lib/libOPENFHEcore_static.a:ro",
    "--volume",
    "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a:/work/install/fideslib/lib/fideslib.a:ro",
    "--volume",
    "${baseline}:/baseline:ro",
    "--workdir",
    "/study",
    "--env",
    "OMP_NUM_THREADS=4",
    "--env",
    "OMP_PROC_BIND=true",
    "--env",
    "OMP_PLACES={80},{82},{83},{84}",
    "--env",
    "LD_LIBRARY_PATH=/workspace/install/openfhe-fides/lib:/usr/local/cuda/lib64",
    "--gpus",
    "device=5",
    "--volume",
    "${payload_study}:/payloads:ro",
    "${image}",
    "/study/build/operation-replay-r3/packed_operation_replay",
    "/study/isolation-refresh/case.txt",
    "/study/replay-refresh/native.json"
  ],
  "cwd": "${study}",
  "inputs": {
    "source": "${study}/replay-r3-source.tar.gz",
    "binary": "${study}/build/operation-replay-r3/packed_operation_replay",
    "case": "${study}/isolation-refresh/case.txt",
    "fideslib": "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a",
    "openfhe_core": "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a"
  },
  "timeout_seconds": 600
}
