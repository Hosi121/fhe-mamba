{
  "schema_version": 1,
  "command": [
    "docker",
    "run",
    "--rm",
    "--name",
    "cipher-long-accuracy-configure-replay-r5",
    "--user",
    "${UID}:${GID}",
    "--cpuset-cpus",
    "96-100",
    "--cpuset-mems",
    "3",
    "--shm-size",
    "1g",
    "--volume",
    "${root}:/workspace:ro",
    "--volume",
    "${root}/b300-mamba3-20260926:/work:ro",
    "--volume",
    "${study}:/study",
    "--volume",
    "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a:/workspace/install/openfhe-fides/lib/libOPENFHEcore_static.a:ro",
    "--volume",
    "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a:/work/install/fideslib/lib/fideslib.a:ro",
    "--workdir",
    "/study",
    "--env",
    "OMP_NUM_THREADS=4",
    "--env",
    "OMP_PROC_BIND=true",
    "--env",
    "OMP_PLACES={96},{98},{99},{100}",
    "--env",
    "LD_LIBRARY_PATH=/workspace/install/openfhe-fides/lib:/usr/local/cuda/lib64",
    "--gpus",
    "device=6",
    "${image}",
    "cmake",
    "-S",
    "/study/repo-replay-r5/experiments/packed_diagnostics",
    "-B",
    "/study/build/replay-r5",
    "-DCMAKE_BUILD_TYPE=Release",
    "-DFHE_STAGE0_GPU_RNS=ON",
    "-DFHE_STAGE0_GPU_DUAL_RING=ON",
    "-DCMAKE_CUDA_ARCHITECTURES=103-real",
    "-DCMAKE_CXX_COMPILER=/usr/bin/g++",
    "-DCMAKE_PREFIX_PATH=/work/install/fideslib;/workspace/install/openfhe-fides",
    "-DCMAKE_CXX_FLAGS=-I/workspace/b300-nsight-20260926/include"
  ],
  "cwd": "${study}",
  "inputs": {
    "source": "${study}/replay-r5-source.tar.gz",
    "openfhe_core": "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a",
    "fideslib": "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a"
  },
  "timeout_seconds": 1800
}
