{
  "schema_version": 1,
  "command": [
    "docker",
    "run",
    "--rm",
    "--name",
    "cipher-long-accuracy-oracle-p-r3-ntt",
    "--user",
    "${UID}:${GID}",
    "--cpuset-cpus",
    "64-68",
    "--cpuset-mems",
    "2",
    "--shm-size",
    "1g",
    "--volume",
    "${root}:/workspace:ro",
    "--volume",
    "${root}/b300-mamba3-20260926:/work:ro",
    "--volume",
    "${study}:/study",
    "--volume",
    "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a:/workspace/install/openfhe-fides/lib/libOPENFHEcore_static.a:ro",
    "--volume",
    "${study}/ntt-backend/fideslib.a:/work/install/fideslib/lib/fideslib.a:ro",
    "--workdir",
    "/study",
    "--env",
    "OMP_NUM_THREADS=4",
    "--env",
    "OMP_PROC_BIND=true",
    "--env",
    "OMP_PLACES={64},{66},{67},{68}",
    "--env",
    "LD_LIBRARY_PATH=/workspace/install/openfhe-fides/lib:/usr/local/cuda/lib64",
    "--gpus",
    "device=4",
    "${image}",
    "/study/build/oracle-p-r3-ntt/ntt_lazy_oracle",
    "/study/oracle-p-r3-ntt/native.json",
    "/study/ntt-p-r3-golden.bin",
    "131072",
    "--digits",
    "4",
    "--special-primes"
  ],
  "cwd": "${study}",
  "inputs": {
    "source": "${study}/oracle-p-r3-source.tar.gz",
    "openfhe_core": "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a",
    "fideslib": "${study}/ntt-backend/fideslib.a",
    "binary": "${study}/build/oracle-p-r3-ntt/ntt_lazy_oracle",
    "golden": "${study}/ntt-p-r3-golden.bin"
  },
  "timeout_seconds": 1800
}
