{
  "schema_version": 1,
  "command": [
    "docker",
    "run",
    "--rm",
    "--name",
    "cipher-long-accuracy-ncu-ntt-r4-base-half1",
    "--user",
    "0:0",
    "--cpuset-cpus",
    "64-68",
    "--cpuset-mems",
    "2",
    "--shm-size",
    "1g",
    "--volume",
    "${root}:/workspace:ro",
    "--volume",
    "${root}/b300-mamba3-20260926:/work:ro",
    "--volume",
    "${study}:/study",
    "--volume",
    "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a:/workspace/install/openfhe-fides/lib/libOPENFHEcore_static.a:ro",
    "--volume",
    "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a:/work/install/fideslib/lib/fideslib.a:ro",
    "--workdir",
    "/study",
    "--env",
    "OMP_NUM_THREADS=4",
    "--env",
    "OMP_PROC_BIND=true",
    "--env",
    "OMP_PLACES={64},{66},{67},{68}",
    "--env",
    "LD_LIBRARY_PATH=/workspace/install/openfhe-fides/lib:/usr/local/cuda/lib64",
    "--gpus",
    "device=4",
    "--cap-add=SYS_ADMIN",
    "--cap-add=PERFMON",
    "--security-opt",
    "seccomp=unconfined",
    "${image}",
    "/usr/local/cuda/bin/ncu",
    "--kernel-name-base",
    "demangled",
    "--kernel-name",
    "regex:.*NTT_<\\(bool\\)1,.*NTT_MODE.*1>.*",
    "--launch-skip",
    "11",
    "--launch-count",
    "4",
    "--clock-control",
    "none",
    "--section",
    "SpeedOfLight",
    "--section",
    "LaunchStats",
    "--section",
    "Occupancy",
    "--section",
    "MemoryWorkloadAnalysis",
    "--section",
    "SchedulerStats",
    "--section",
    "WarpStateStats",
    "-o",
    "/study/ncu-ntt-r4-base-half1/profile",
    "/study/build/oracle-p-r3-base/ntt_lazy_oracle",
    "/study/ncu-ntt-r4-base-half1/native.json",
    "/study/ntt-p-r3-golden.bin",
    "131072",
    "--digits",
    "4",
    "--special-primes"
  ],
  "cwd": "${study}",
  "inputs": {
    "source": "${study}/oracle-p-r3-source.tar.gz",
    "openfhe_core": "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a",
    "fideslib": "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a",
    "binary": "${study}/build/oracle-p-r3-base/ntt_lazy_oracle",
    "golden": "${study}/ntt-p-r3-golden.bin"
  },
  "timeout_seconds": 1800
}
