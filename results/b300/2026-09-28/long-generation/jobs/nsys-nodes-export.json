{
  "schema_version": 1,
  "command": [
    "docker",
    "run",
    "--rm",
    "--name",
    "cipher-long-generation-nsys-nodes-export",
    "--user",
    "0:0",
    "--cpuset-cpus",
    "112-116",
    "--cpuset-mems",
    "3",
    "--shm-size",
    "1g",
    "--volume",
    "${root}:/workspace:ro",
    "--volume",
    "${root}/b300-mamba3-20260926:/work:ro",
    "--volume",
    "${study}:/study",
    "--volume",
    "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a:/workspace/install/openfhe-fides/lib/libOPENFHEcore_static.a:ro",
    "--volume",
    "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a:/work/install/fideslib/lib/fideslib.a:ro",
    "--volume",
    "${baseline}:/baseline:ro",
    "--workdir",
    "/study",
    "--env",
    "OMP_NUM_THREADS=4",
    "--env",
    "OMP_PROC_BIND=true",
    "--env",
    "OMP_PLACES={112},{114},{115},{116}",
    "--env",
    "LD_LIBRARY_PATH=/workspace/install/openfhe-fides/lib:/usr/local/cuda/lib64",
    "--gpus",
    "device=7",
    "--cap-add=SYS_ADMIN",
    "--cap-add=PERFMON",
    "--security-opt",
    "seccomp=unconfined",
    "--volume",
    "${root}/b300-nsight-20260926/tools/nsys:/nsys-tool:ro",
    "${image}",
    "/nsys-tool/opt/nvidia/nsight-systems-cli/2025.5.1/target-linux-x64/nsys",
    "export",
    "--type=sqlite",
    "--output=/study/nsys-nodes/trace.sqlite",
    "/study/nsys-nodes/trace.nsys-rep"
  ],
  "cwd": "${study}",
  "inputs": {
    "report": "${study}/nsys-nodes/trace.nsys-rep"
  },
  "timeout_seconds": 900
}
