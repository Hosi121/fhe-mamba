{
  "schema_version": 1,
  "command": [
    "docker",
    "run",
    "--rm",
    "--user",
    "${UID}:${GID}",
    "--volume",
    "${study}:/study:ro",
    "--entrypoint",
    "/usr/local/cuda/bin/ncu",
    "${image}",
    "--import",
    "/study/ncu-modup/profile.ncu-rep",
    "--page",
    "raw",
    "--csv"
  ],
  "cwd": "${study}",
  "inputs": {
    "report": "${study}/ncu-modup/profile.ncu-rep"
  },
  "timeout_seconds": 180
}
