{
  "schema_version": 1,
  "command": [
    "docker",
    "run",
    "--rm",
    "--name",
    "cipher-long-generation-unprofiled-prefix",
    "--user",
    "${UID}:${GID}",
    "--cpuset-cpus",
    "96-100",
    "--cpuset-mems",
    "3",
    "--shm-size",
    "1g",
    "--volume",
    "${root}:/workspace:ro",
    "--volume",
    "${root}/b300-mamba3-20260926:/work:ro",
    "--volume",
    "${study}:/study",
    "--volume",
    "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a:/workspace/install/openfhe-fides/lib/libOPENFHEcore_static.a:ro",
    "--volume",
    "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a:/work/install/fideslib/lib/fideslib.a:ro",
    "--volume",
    "${baseline}:/baseline:ro",
    "--workdir",
    "/study",
    "--env",
    "OMP_NUM_THREADS=4",
    "--env",
    "OMP_PROC_BIND=true",
    "--env",
    "OMP_PLACES={96},{98},{99},{100}",
    "--env",
    "LD_LIBRARY_PATH=/workspace/install/openfhe-fides/lib:/usr/local/cuda/lib64",
    "--gpus",
    "device=6",
    "--cap-add=SYS_ADMIN",
    "--cap-add=PERFMON",
    "--security-opt",
    "seccomp=unconfined",
    "--volume",
    "${root}/b300-nsight-20260926/tools/nsys:/nsys-tool:ro",
    "${image}",
    "/study/build/native-r2/packed_fideslib",
    "/study/payload/tiled2-prefix/program.txt",
    "/study/unprofiled-prefix/native.json",
    ".001",
    ".001",
    "--planned-refresh",
    "--batch-refresh",
    "--inplace-ops",
    "--gpu-plaintext-ntt",
    "--profile-evaluation",
    "--naf-rotations",
    "--reuse-dead-inputs",
    "--direct-plaintext-upload",
    "--compact-weights",
    "--move-plaintext-coefficients",
    "--borrow-plaintext-upload",
    "--bsgs-routing-stages",
    "--cache-plaintexts",
    "--frontier-refresh",
    "--s2c-first",
    "--gpu-plaintext-rns",
    "--hoist-rotations",
    "--share-chebyshev",
    "--prefetch-plaintexts",
    "--prefetch-workers",
    "2",
    "--security",
    "128-classic",
    "--security-digits",
    "4",
    "--gpu-addend-rns",
    "--plaintext-cache-capacity",
    "2048",
    "--merge-refresh-correction",
    "--gpu-plaintext-fft",
    "--frontier-live-limit",
    "256",
    "--client-head",
    "/study/payload/tiled2-prefix/client_head.f32"
  ],
  "cwd": "${study}",
  "inputs": {
    "source": "${study}/source.tar.gz",
    "native_source": "${study}/source-r2.tar.gz",
    "binary": "${study}/build/native-r2/packed_fideslib",
    "openfhe_core": "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a",
    "fideslib": "${root}/b300-gpu-ifft-20260927/dependencies/lib/fideslib.a",
    "program": "${study}/payload/tiled2-prefix/program.txt",
    "manifest": "${study}/payload/tiled2-prefix/manifest.json",
    "fixture": "${study}/payload/tiled2-prefix/fixture.npz",
    "client_head": "${study}/payload/tiled2-prefix/client_head.f32"
  },
  "timeout_seconds": 1800
}
