{
  "schema_version": 1,
  "command": [
    "docker",
    "run",
    "--rm",
    "--name",
    "cipher-recurrent-memory-candidate-tiled-64",
    "--user",
    "${UID}:${GID}",
    "--cpuset-cpus",
    "96-100",
    "--cpuset-mems",
    "3",
    "--shm-size",
    "1g",
    "--volume",
    "${root}:/workspace:ro",
    "--volume",
    "${root}/b300-mamba3-20260926:/work:ro",
    "--volume",
    "${study}:/study",
    "--volume",
    "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a:/workspace/install/openfhe-fides/lib/libOPENFHEcore_static.a:ro",
    "--volume",
    "${baseline}/dependencies/lib/fideslib.a:/work/install/fideslib/lib/fideslib.a:ro",
    "--volume",
    "${baseline}:/baseline:ro",
    "--workdir",
    "/study",
    "--env",
    "OMP_NUM_THREADS=4",
    "--env",
    "OMP_PROC_BIND=true",
    "--env",
    "OMP_PLACES={96},{98},{99},{100}",
    "--env",
    "LD_LIBRARY_PATH=/workspace/install/openfhe-fides/lib:/usr/local/cuda/lib64",
    "--gpus",
    "device=6",
    "${image}",
    "/study/build/native/packed_fideslib",
    "/workspace/b300-recurrent-state-20260927/r2/payload/tiled-64/program.txt",
    "/study/candidate-tiled-64/native.json",
    ".001",
    ".001",
    "--planned-refresh",
    "--batch-refresh",
    "--inplace-ops",
    "--gpu-plaintext-ntt",
    "--profile-evaluation",
    "--naf-rotations",
    "--reuse-dead-inputs",
    "--direct-plaintext-upload",
    "--compact-weights",
    "--move-plaintext-coefficients",
    "--borrow-plaintext-upload",
    "--bsgs-routing-stages",
    "--cache-plaintexts",
    "--frontier-refresh",
    "--s2c-first",
    "--gpu-plaintext-rns",
    "--hoist-rotations",
    "--share-chebyshev",
    "--prefetch-plaintexts",
    "--prefetch-workers",
    "2",
    "--security",
    "128-classic",
    "--security-digits",
    "4",
    "--gpu-addend-rns",
    "--plaintext-cache-capacity",
    "2048",
    "--merge-refresh-correction",
    "--gpu-plaintext-fft",
    "--frontier-live-limit",
    "128"
  ],
  "cwd": "${study}",
  "inputs": {
    "source": "${payloads}/source.tar.gz",
    "native_source": "${study}/source-build.tar.gz",
    "openfhe_core": "${root}/b300-nsight-20260926/lib/libOPENFHEcore_static.a",
    "fideslib": "${baseline}/dependencies/lib/fideslib.a",
    "binary": "${study}/build/native/packed_fideslib",
    "program": "${payloads}/payload/tiled-64/program.txt",
    "fixture": "${payloads}/payload/tiled-64/fixture.npz",
    "manifest": "${payloads}/payload/tiled-64/manifest.json",
    "trace": "${payloads}/payload/trace/trace.npz"
  },
  "timeout_seconds": 1800
}
