{
  "name": "ncu-base",
  "profile": true,
  "cpu_only": false,
  "timeout": 1200,
  "command": [
    "/usr/local/cuda/bin/ncu",
    "--profile-from-start",
    "off",
    "--kernel-name-base",
    "demangled",
    "--kernel-name",
    "regex:.*NTT_<.*NTT_MODE.*1>.*",
    "--launch-count",
    "4",
    "--clock-control",
    "none",
    "--section",
    "SpeedOfLight",
    "--section",
    "LaunchStats",
    "--section",
    "Occupancy",
    "--section",
    "MemoryWorkloadAnalysis",
    "-f",
    "-o",
    "/study/ncu-base/profile",
    "/study/bin/base/packed_fideslib",
    "/workspace/b300-nsight-20260926/prefix/program.txt",
    "/study/ncu-base/native.json",
    ".001",
    ".001",
    "--planned-refresh",
    "--batch-refresh",
    "--inplace-ops",
    "--gpu-plaintext-ntt",
    "--profile-evaluation",
    "--naf-rotations",
    "--reuse-dead-inputs",
    "--direct-plaintext-upload",
    "--compact-weights",
    "--move-plaintext-coefficients",
    "--borrow-plaintext-upload",
    "--bsgs-routing-stages",
    "--cache-plaintexts",
    "--frontier-refresh",
    "--s2c-first",
    "--gpu-plaintext-rns",
    "--hoist-rotations",
    "--share-chebyshev",
    "--client-head",
    "/work/payload/client_head.f32",
    "--gpu-dual-ring",
    "--prefetch-plaintexts"
  ]
}
