{
  "name": "nsys-prefix-v2",
  "profile": true,
  "timeout": 900,
  "command": [
    "/study/tools/nsys/opt/nvidia/nsight-systems-cli/2025.5.1/target-linux-x64/nsys",
    "profile",
    "--trace=cuda,nvtx,osrt",
    "--cuda-event-trace=false",
    "--sample=process-tree",
    "--cpuctxsw=process-tree",
    "--backtrace=dwarf",
    "--capture-range=cudaProfilerApi",
    "--capture-range-end=stop",
    "--force-overwrite=true",
    "-o",
    "/study/nsys-prefix-v2/trace",
    "/work/build/native/packed_fideslib",
    "/study/prefix/program.txt",
    "/study/nsys-prefix-v2/native.json",
    ".001",
    ".001",
    "--planned-refresh",
    "--batch-refresh",
    "--inplace-ops",
    "--gpu-plaintext-ntt",
    "--profile-evaluation",
    "--naf-rotations",
    "--reuse-dead-inputs",
    "--direct-plaintext-upload",
    "--compact-weights",
    "--move-plaintext-coefficients",
    "--borrow-plaintext-upload",
    "--bsgs-routing-stages",
    "--cache-plaintexts",
    "--frontier-refresh",
    "--s2c-first",
    "--gpu-plaintext-rns",
    "--hoist-rotations",
    "--share-chebyshev",
    "--client-head",
    "/work/payload/client_head.f32",
    "--gpu-dual-ring"
  ]
}
