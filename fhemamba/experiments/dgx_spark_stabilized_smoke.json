{
  "name": "dgx-spark-stabilized-smoke",
  "version": "0.5.0",
  "timeout_seconds": 4200,
  "gpu_preflight": {
    "required": true,
    "gpu_index": 0,
    "max_utilization_percent": 5,
    "min_mem_available_gib": 65,
    "stable_polls": 2,
    "poll_seconds": 5,
    "timeout_seconds": 120
