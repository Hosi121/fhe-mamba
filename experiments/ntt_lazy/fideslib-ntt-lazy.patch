+// Harvey's inverse butterfly (Algorithm 4), with canonical boundaries.
+// The forward CT network retains residues in [0,4p) between stages. Shoup's
+// quotient bound holds for its full word-sized input, not only inputs < p.
+template <typename T, ALGO algo>
+__device__ __forceinline__ void CT_butterfly_lazy(T& c, T& d, T psi, int primeid, T shoup_psi) {
+    if constexpr (sizeof(T) == 8 && algo == ALGO_SHOUP) {
+        const uint64_t p = C_.primes[primeid];
+        if (p < (uint64_t(1) << 62)) {
+            const uint64_t twice = p + p;
+            uint64_t a = c;
+            if (a >= twice) a -= twice;
+            const uint64_t q = __umul64hi(d, shoup_psi);
+            const uint64_t t = d * psi - q * p;
+            c = a + t;
+            d = a + twice - t;
+            return;
+        }
+    }
+    CT_butterfly<T, algo>(c, d, psi, primeid, shoup_psi);
+}
